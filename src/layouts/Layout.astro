---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { initI18n } from '../i18n';

interface Props {
    title: string;
}

const { title } = Astro.props;
const t = initI18n(Astro.currentLocale!);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <header class="lang-header">
            <select id="language-selector" class="language-dropdown">
                <option value="/" data-label="Deutsch" selected={Astro.currentLocale === 'de'}>Deutsch</option>
                <option value="/es" data-label="Español" selected={Astro.currentLocale === 'es'}>Español</option>
                <option value="/en" data-label="English" selected={Astro.currentLocale === 'en'}>English</option>
            </select>
        </header>
        <slot />
        <footer>
            <a href={getRelativeLocaleUrl(Astro.currentLocale!, 'privacy')}>
                {t('privacyPolicy')}
            </a>
            <p class="copyright">© The Metropoliplan Team 2015-2026</p>
        </footer>
    </body>
</html>
<style is:global>
    :root {
        --accent: 22, 29, 92;
        --accent-bg: #f4f4ff;
        --accent-medium: 119, 127, 198;
        --accent-light: 211, 211, 255;
        --accent-dark: 22, 29, 92;
        --accent-gradient: linear-gradient(
            45deg,
            rgb(var(--accent)),
            rgb(var(--accent-medium))
        );
    }
    * {
        color: rgb(var(--accent-dark));
    }
    ul, ol {
      list-style: disc inside;
      padding-left: 1.5em;
    }
    .lang-header {
        margin: auto;
        width: 800px;
        max-width: calc(100% - 2rem);
        padding: 1rem 0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }
    .language-dropdown {
        padding: 0.5rem;
        border: 2px solid rgb(var(--accent));
        border-radius: 4px;
        background-color: white;
        color: rgb(var(--accent-dark));
        font-size: 0.95rem;
        cursor: pointer;
    }
    .language-dropdown:hover {
        background-color: var(--accent-bg);
    }
    html {
        min-height: 100%;
        font-family: system-ui, sans-serif;
        background: linear-gradient(45deg, var(--accent-bg), #d4d4ee);
    }
    code {
        font-family:
            Menlo,
            Monaco,
            Lucida Console,
            Liberation Mono,
            DejaVu Sans Mono,
            Bitstream Vera Sans Mono,
            Courier New,
            monospace;
    }
    footer {
        margin: auto;
        padding: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
        text-align: center;
    }
    a,
    a:visited {
        color: rgb(var(--accent));
    }
    a + a {
        margin-left: 16px;
    }
    .copyright {
        font-size: 0.8rem;
    }
</style>

<script>
    const languageSelector = document.getElementById('language-selector');
    if (languageSelector) {
        languageSelector.addEventListener('change', (e) => {
            const target = e.target as HTMLSelectElement;
            window.location.href = target.value;
        });
    }
</script>
